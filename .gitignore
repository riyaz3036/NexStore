# Ignore node modules
frontend/node_modules/
backend/node_modules/

# Ignore environment files
frontend/.env
backend/.env
backen/src/main/resources/application.properties
*application.properties

echo "application.properties" >> .gitignore
echo "application-*.properties" >> .gitignore
echo "*.env" >> .gitignore

# Ignore build output
frontend/dist/
backend/dist/
frontend/build/
backend/build/

# Ignore log files
*.log
